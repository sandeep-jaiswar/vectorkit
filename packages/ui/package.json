{
  "name": "@vectorkit/ui",
  "version": "0.0.0",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./button": {
      "types": "./src/button.tsx",
      "import": "./dist/button.mjs",
      "require": "./dist/button.js"
    },
    "./input": {
      "types": "./src/input.tsx",
      "import": "./dist/input.mjs",
      "require": "./dist/input.js"
    },
    "./card": {
      "types": "./src/card.tsx",
      "import": "./dist/card.mjs",
      "require": "./dist/card.js"
    },
    "./hero-tray": {
      "types": "./src/hero-tray.tsx",
      "import": "./dist/hero-tray.mjs",
      "require": "./dist/hero-tray.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "devDependencies": {
    "@vectorkit/eslint-config": "*",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "eslint": "^8.57.0",
    "@vectorkit/typescript-config": "*",
    "tsup": "^8.0.2",
    "typescript": "5.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@vectorkit/design-tokens": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}